datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_STUDENT
  RESOLVED
  CLOSED
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportAuthorKind {
  STUDENT
  STAFF
  SYSTEM
}

model Organization {
  id         String    @id @default(uuid())
  name       String
  slug       String    @unique // stable code
  timezone   String    @default("Africa/Cairo")
  currency   String    @default("EGP")
  status     String    @default("ACTIVE")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?
  version    Int       @default(1)

  paymentInstapay String?
  paymentWallet   String?

  branches      Branch[]
  academicYears AcademicYear[]
  grades        Grade[]
  subjects      Subject[]
  cohorts       Cohort[]
  auditEvents   AuditEvent[]
  accounts      Account[]
  courses       Course[]
  products      Product[]
}

model Branch {
  id             String    @id @default(uuid())
  organizationId String
  code           String // stable code
  nameAr         String // localized Arabic name
  nameEn         String? // localized English name (optional)
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  archivedAt     DateTime?
  version        Int       @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, code])
  @@index([organizationId])
}

model AcademicYear {
  id             String    @id @default(uuid())
  organizationId String
  label          String // label (e.g. 2026/27)
  startsOn       DateTime
  endsOn         DateTime
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  archivedAt     DateTime?
  version        Int       @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  cohorts      Cohort[]

  @@unique([organizationId, label])
  @@index([organizationId])
}

model Grade {
  id             String    @id @default(uuid())
  organizationId String
  code           String // stable code
  nameAr         String // localized Arabic name
  nameEn         String? // localized English name (optional)
  sort           Int       @default(0)
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  archivedAt     DateTime?
  version        Int       @default(1)

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  cohorts         Cohort[]
  courses         Course[]
  products        Product[]
  studentProfiles StudentProfile[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Subject {
  id             String    @id @default(uuid())
  organizationId String
  code           String // stable code
  nameAr         String // localized Arabic name
  nameEn         String? // localized English name (optional)
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  archivedAt     DateTime?
  version        Int       @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  courses      Course[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Cohort {
  id             String    @id @default(uuid())
  organizationId String
  academicYearId String
  gradeId        String
  startsAt       DateTime
  expiresAt      DateTime
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  archivedAt     DateTime?
  version        Int       @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  grade        Grade        @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  terms        Term[]

  @@unique([organizationId, academicYearId, gradeId])
  @@index([organizationId])
  @@index([academicYearId])
  @@index([gradeId])
}

model Term {
  id         String    @id @default(uuid())
  cohortId   String
  code       String // stable code
  titleAr    String // localized Arabic title
  titleEn    String? // localized English title (optional)
  startsAt   DateTime
  endsAt     DateTime
  sort       Int       @default(0)
  status     String    @default("ACTIVE")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?
  version    Int       @default(1)

  cohort  Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  courses Course[]

  @@unique([cohortId, code])
  @@index([cohortId])
}

model AuditEvent {
  id             String   @id @default(uuid())
  organizationId String
  actorType      String
  actorId        String?
  action         String
  targetType     String
  targetId       String
  before         Json?
  after          Json?
  reason         String?
  traceId        String?
  createdAt      DateTime @default(now())
  previousHash   String?
  eventHash      String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@index([organizationId, targetType, targetId, createdAt])
  @@index([organizationId, actorId, action, createdAt])
}

model OutboxEvent {
  id             String    @id @default(uuid())
  eventType      String
  aggregateType  String
  aggregateId    String
  payload        Json
  idempotencyKey String    @unique
  status         String    @default("PENDING")
  attemptCount   Int       @default(0)
  nextAttemptAt  DateTime? @default(now())
  claimedAt      DateTime?
  claimedBy      String?
  processedAt    DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, nextAttemptAt])
}

model Account {
  id                     String    @id @default(uuid())
  organizationId         String
  kind                   String // STUDENT, GUARDIAN, STAFF
  phoneEncrypted         String?
  phoneHmac              String? // Keyed HMAC for exact lookup
  phoneVerificationState String    @default("UNVERIFIED_V1")
  emailEncrypted         String?
  emailHmac              String?
  emailVerificationState String    @default("UNVERIFIED_V1")
  passwordHash           String
  mustChangePassword     Boolean   @default(false)
  locale                 String    @default("ar")
  status                 String    @default("ACTIVE")
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  archivedAt             DateTime?
  deletedAt              DateTime?
  version                Int       @default(1)

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  studentProfile        StudentProfile?
  guardianProfile       GuardianProfile?
  staffProfile          StaffProfile?
  activation            AccountActivation?
  authSessions          AuthSession[]
  totpFactor            TotpFactor?
  totpEnrollmentSession TotpEnrollmentSession?
  staffRecoveryCodes    StaffRecoveryCode[]
  passwordResetCases    PasswordResetCase[]
  staffAccessIdentities StaffAccessIdentity[]
  accountRoles          AccountRole[]
  devices               StudentDevice[]
  entitlements          Entitlement[]
  assessmentAttempts    AssessmentAttempt[]
  supportTickets        SupportTicket[]
  notifications         InAppNotification[]
  supportMessages       SupportMessage[]

  @@unique([organizationId, phoneHmac])
  @@unique([organizationId, emailHmac])
  @@index([phoneHmac])
  @@index([emailHmac])
  @@index([organizationId, kind, status, archivedAt, deletedAt])
}

model StudentProfile {
  id                   String   @id @default(uuid())
  accountId            String   @unique
  gradeId              String?
  displayName          String
  firstName            String?
  secondName           String?
  thirdName            String?
  lastName             String?
  fatherPhoneEncrypted String?
  motherPhoneEncrypted String?
  schoolName           String?
  guardianOccupation   String?
  gender               String?
  city                 String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  account   Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  grade     Grade?            @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  guardians StudentGuardian[]

  @@index([gradeId])
}

model GuardianProfile {
  id                  String   @id @default(uuid())
  accountId           String   @unique
  displayName         String
  deliveryPreferences String   @default("APP")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  account  Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  students StudentGuardian[]
}

model StaffProfile {
  id          String   @id @default(uuid())
  accountId   String   @unique
  displayName String
  staffStatus String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account         Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  assignedTickets SupportTicket[]
}

model SecurityEvent {
  id        String   @id @default(uuid())
  accountId String?
  phoneHmac String?
  eventType String
  outcome   String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([accountId])
  @@index([phoneHmac])
}

model AccountActivation {
  id             String    @id @default(uuid())
  accountId      String    @unique
  source         String // STAFF, ROSTER, GUARDIAN, STAFF_INVITE
  credentialHash String
  issuedBy       String?
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  attemptCount   Int       @default(0)
  consumedAt     DateTime?
  revokedAt      DateTime?

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model AuthSession {
  id                String    @id @default(uuid())
  accountId         String
  tokenHash         String    @unique
  createdAt         DateTime  @default(now())
  idleExpiresAt     DateTime
  absoluteExpiresAt DateTime
  lastSeenAt        DateTime  @default(now())
  revokedAt         DateTime?
  revokedReason     String?
  ipAddress         String?
  userAgent         String?

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([tokenHash])
}

model Role {
  id              String           @id @default(uuid())
  code            String           @unique // OWNER, ADMINISTRATOR, CONTENT, ACADEMIC, FINANCE, SUPPORT, ANALYST
  description     String?
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]
  accountRoles    AccountRole[]
}

model Permission {
  id              String           @id @default(uuid())
  code            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model AccountRole {
  id            String   @id @default(uuid())
  accountId     String
  roleId        String
  branchScopeId String?
  createdAt     DateTime @default(now())
  grantedBy     String?

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([accountId, roleId, branchScopeId])
  @@index([accountId])
}

model TotpFactor {
  id              String   @id @default(uuid())
  accountId       String   @unique
  secretEncrypted String
  secretVersion   Int      @default(1)
  lastUsedStep    BigInt   @default(0)
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model TotpEnrollmentSession {
  id              String   @id @default(uuid())
  accountId       String   @unique
  purpose         String // INITIAL, RECOVERY, FORCED_REENROLL
  secretEncrypted String
  secretVersion   Int      @default(1)
  tokenHash       String   @unique
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
  expiresAt       DateTime

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model StaffRecoveryCode {
  id         String    @id @default(uuid())
  accountId  String
  codeHash   String
  createdAt  DateTime  @default(now())
  consumedAt DateTime?

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model PasswordResetCase {
  id                String    @id @default(uuid())
  targetAccountId   String
  initiatorStaffId  String
  approverStaffId   String?
  identityChecklist Json
  reason            String
  status            String    @default("PENDING")
  credentialHash    String
  createdAt         DateTime  @default(now())
  expiresAt         DateTime
  consumedAt        DateTime?
  sessionRevokedAt  DateTime?
  version           Int       @default(1)

  targetAccount Account @relation(fields: [targetAccountId], references: [id], onDelete: Cascade)
}

model StaffAccessIdentity {
  id             String   @id @default(uuid())
  accountId      String
  provider       String   @default("CLOUDFLARE_ACCESS")
  audience       String
  subject        String
  emailEncrypted String?
  emailHmac      String?
  createdAt      DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, provider, subject])
}

model StudentDevice {
  id                String   @id @default(uuid())
  accountId         String
  deviceFingerprint String
  label             String?
  createdAt         DateTime @default(now())
  lastUsedAt        DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, deviceFingerprint])
  @@index([accountId])
}

model ActivityLease {
  id                String   @id @default(uuid())
  accountId         String   @unique
  sessionId         String
  deviceFingerprint String
  activityType      String
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([accountId])
}

model StudentGuardian {
  studentProfileId  String
  guardianProfileId String
  relationshipType  String   @default("PRIMARY")
  createdAt         DateTime @default(now())

  student  StudentProfile  @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  guardian GuardianProfile @relation(fields: [guardianProfileId], references: [id], onDelete: Cascade)

  @@id([studentProfileId, guardianProfileId])
  @@index([studentProfileId])
  @@index([guardianProfileId])
}

model Course {
  id             String        @id @default(uuid())
  organizationId String
  gradeId        String?
  subjectId      String?
  termId         String?
  code           String
  titleAr        String
  titleEn        String?
  descriptionAr  String?
  coverImageUrl  String?
  status         PublishStatus @default(DRAFT)
  publishAt      DateTime?
  unpublishAt    DateTime?
  archivedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  version        Int           @default(1)

  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  grade           Grade?               @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  subject         Subject?             @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  term            Term?                @relation(fields: [termId], references: [id], onDelete: Restrict)
  chapters        Chapter[]
  products        ProductCourse[]
  prerequisites   CoursePrerequisite[] @relation("CourseToPrerequisite")
  prerequisiteFor CoursePrerequisite[] @relation("PrerequisiteToCourse")
  assessments     Assessment[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([gradeId])
  @@index([subjectId])
  @@index([termId])
  @@index([status, publishAt, unpublishAt])
  @@index([organizationId, gradeId, status, updatedAt])
}

model Chapter {
  id          String        @id @default(uuid())
  courseId    String
  titleAr     String
  titleEn     String?
  sort        Int           @default(0)
  status      PublishStatus @default(DRAFT)
  publishAt   DateTime?
  unpublishAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  version     Int           @default(1)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  units  Unit[]

  @@index([courseId])
  @@index([status, publishAt, unpublishAt])
}

model Unit {
  id                       String        @id @default(uuid())
  chapterId                String
  prerequisiteAssessmentId String?
  titleAr                  String
  titleEn                  String?
  sort                     Int           @default(0)
  status                   PublishStatus @default(DRAFT)
  publishAt                DateTime?
  unpublishAt              DateTime?
  archivedAt               DateTime?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  version                  Int           @default(1)

  chapter                Chapter       @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  prerequisiteAssessment Assessment?   @relation("UnitPrerequisite", fields: [prerequisiteAssessmentId], references: [id], onDelete: SetNull)
  lessons                Lesson[]
  productEntries         ProductUnit[]
  assessments            Assessment[]  @relation("UnitAssessments")

  @@index([chapterId])
  @@index([prerequisiteAssessmentId])
  @@index([status, publishAt, unpublishAt])
}

model Lesson {
  id              String        @id @default(uuid())
  unitId          String
  titleAr         String
  titleEn         String?
  contentType     String        @default("VIDEO") // VIDEO, PDF, TEXT
  contentUrl      String?
  attachedPdfUrl  String?
  homeworkPdfUrl  String?
  durationSeconds Int           @default(0)
  sort            Int           @default(0)
  status          PublishStatus @default(DRAFT)
  publishAt       DateTime?
  unpublishAt     DateTime?
  archivedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  version         Int           @default(1)

  unit        Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  assessments Assessment[]

  @@index([unitId])
  @@index([status, publishAt, unpublishAt])
}

model CoursePrerequisite {
  courseId             String
  prerequisiteCourseId String
  createdAt            DateTime @default(now())

  course       Course @relation("CourseToPrerequisite", fields: [courseId], references: [id], onDelete: Cascade)
  prerequisite Course @relation("PrerequisiteToCourse", fields: [prerequisiteCourseId], references: [id], onDelete: Restrict)

  @@id([courseId, prerequisiteCourseId])
}

model Product {
  id             String    @id @default(uuid())
  organizationId String
  gradeId        String?
  code           String
  titleAr        String
  titleEn        String?
  type           String    @default("BUNDLE")
  coverImageUrl  String?
  descriptionAr  String?
  status         String    @default("ACTIVE")
  publishAt      DateTime?
  unpublishAt    DateTime?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  version        Int       @default(1)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  grade        Grade?          @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  prices       Price[]
  courses      ProductCourse[]
  unitEntries  ProductUnit[]
  entitlements Entitlement[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([gradeId])
  @@index([status, publishAt, unpublishAt])
  @@index([organizationId, gradeId, status, updatedAt])
}

model Price {
  id            String    @id @default(uuid())
  productId     String
  amount        Decimal   @db.Decimal(10, 2)
  currency      String    @default("EGP")
  billingPeriod String    @default("ONCE") // ONCE, MONTHLY
  status        String    @default("ACTIVE")
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  version       Int       @default(1)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([status])
}

model ProductCourse {
  productId String
  courseId  String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([productId, courseId])
}

model ProductUnit {
  productId String
  unitId    String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit    Unit    @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([productId, unitId])
  @@index([unitId])
}

model Entitlement {
  id        String    @id @default(uuid())
  accountId String
  productId String
  grantedAt DateTime  @default(now())
  expiresAt DateTime?
  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([accountId])
}

model StoredObject {
  id             String    @id @default(uuid())
  organizationId String
  uploadedBy     String
  bucket         String
  objectKey      String
  originalName   String
  mimeType       String
  sizeBytes      BigInt
  sha256         String?
  scanStatus     String    @default("PENDING")
  scannedAt      DateTime?
  backupStatus   String    @default("PENDING")
  backedUpAt     DateTime?
  status         String    @default("QUARANTINE")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([bucket, objectKey])
  @@index([organizationId])
  @@index([uploadedBy])
  @@index([scanStatus])
}

model PaymentOrder {
  id              String    @id @default(uuid())
  organizationId  String
  accountId       String
  productId       String
  priceId         String
  amountRequested Decimal   @db.Decimal(10, 2)
  currency        String    @default("EGP")
  proofObjectId   String?
  referenceNumber String?
  status          String    @default("PENDING_REVIEW")
  reviewedBy      String?
  reviewedAt      DateTime?
  reviewNote      String?
  idempotencyKey  String    @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  version         Int       @default(1)

  ledgerEntries LedgerEntry[]

  @@index([organizationId])
  @@index([accountId])
  @@index([status])
  @@index([organizationId, status, createdAt])
}

model LedgerEntry {
  id             String   @id @default(uuid())
  organizationId String
  accountId      String
  paymentOrderId String
  entitlementId  String?
  type           String
  amountEgp      Decimal  @db.Decimal(10, 2)
  description    String
  createdAt      DateTime @default(now())

  paymentOrder PaymentOrder @relation(fields: [paymentOrderId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([accountId])
  @@index([paymentOrderId])
}

enum VideoProvider {
  LOCAL
  YOUTUBE
  R2
}

model VideoLesson {
  id               String        @id @default(uuid())
  lessonId         String        @unique
  provider         VideoProvider @default(LOCAL)
  sourceRef        String
  originalFileName String?
  mimeType         String?
  qualityProfile   String        @default("720p_480p")
  durationSeconds  Int           @default(0)
  importedAt       DateTime      @default(now())
  status           String        @default("READY")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  tokens     VideoDeliveryToken[]
  renditions VideoRendition[]
}

model VideoRendition {
  id            String   @id @default(uuid())
  videoLessonId String
  quality       String
  objectKey     String
  width         Int
  height        Int
  bitrateKbps   Int
  fileSizeBytes BigInt
  mimeType      String   @default("video/mp4")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  videoLesson VideoLesson @relation(fields: [videoLessonId], references: [id], onDelete: Cascade)

  @@unique([videoLessonId, quality])
  @@index([videoLessonId])
}

model VideoDeliveryToken {
  id            String    @id @default(uuid())
  videoLessonId String
  accountId     String
  sessionId     String
  tokenHash     String    @unique
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  videoLesson VideoLesson @relation(fields: [videoLessonId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([tokenHash])
}

model LessonProgress {
  id              String    @id @default(uuid())
  accountId       String
  lessonId        String
  watchedSeconds  Int       @default(0)
  durationSeconds Int       @default(0)
  completedAt     DateTime?
  lastHeartbeatAt DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([accountId, lessonId])
  @@index([accountId])
}

model Question {
  id              String    @id @default(uuid())
  organizationId  String
  gradeId         String?
  titleAr         String
  titleEn         String?
  passage         String?
  options         Json
  correctOptionId String
  type            String    @default("MULTIPLE_CHOICE")
  explanation     String?
  imageUrl        String?
  tags            String[]  @default([])
  points          Int       @default(1)
  archivedAt      DateTime?
  version         Int       @default(1)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  assessments AssessmentQuestion[]

  @@index([organizationId])
  @@index([gradeId])
  @@index([organizationId, gradeId, archivedAt, updatedAt])
}

model Assessment {
  id                String        @id @default(uuid())
  type              String        @default("QUIZ")
  lessonId          String?
  unitId            String?
  courseId          String
  titleAr           String
  titleEn           String?
  durationMinutes   Int
  passingScore      Int?
  maxAttempts       Int?
  shuffleQuestions  Boolean       @default(false)
  status            PublishStatus @default(DRAFT)
  resultReleaseRule String        @default("MANUAL")
  publishAt         DateTime?
  unpublishAt       DateTime?
  archivedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  version           Int           @default(1)

  course               Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson               Lesson?              @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  unit                 Unit?                @relation("UnitAssessments", fields: [unitId], references: [id], onDelete: SetNull)
  prerequisiteForUnits Unit[]               @relation("UnitPrerequisite")
  questions            AssessmentQuestion[]
  attempts             AssessmentAttempt[]

  @@index([courseId])
  @@index([unitId])
  @@index([lessonId])
  @@index([status, publishAt, unpublishAt])
}

model AssessmentQuestion {
  assessmentId String
  questionId   String
  sort         Int    @default(0)

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@id([assessmentId, questionId])
}

model AssessmentAttempt {
  id               String    @id @default(uuid())
  assessmentId     String
  accountId        String
  startedAt        DateTime  @default(now())
  expiresAt        DateTime?
  autosavedAnswers Json
  submittedAt      DateTime?
  score            Decimal?  @db.Decimal(5, 2)
  gradedAt         DateTime?
  gradedBy         String?
  resultsReleased  Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  account    Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([assessmentId])
}

model SupportTicket {
  id              String              @id @default(uuid())
  organizationId  String
  accountId       String
  subject         String
  description     String
  status          SupportTicketStatus @default(OPEN)
  priority        SupportPriority     @default(NORMAL)
  assignedStaffId String?
  lastMessageAt   DateTime?
  studentUnreadAt DateTime?
  staffUnreadAt   DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  version         Int                 @default(1)

  account       Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  assignedStaff StaffProfile?    @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)
  messages      SupportMessage[]

  @@index([organizationId])
  @@index([accountId])
  @@index([assignedStaffId])
  @@index([status])
  @@index([organizationId, status, createdAt])
}

model InAppNotification {
  id        String    @id @default(uuid())
  accountId String
  title     String
  content   String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model SupportMessage {
  id              String            @id @default(uuid())
  ticketId        String
  authorAccountId String?
  authorKind      SupportAuthorKind
  body            String
  isInternal      Boolean           @default(false)
  createdAt       DateTime          @default(now())

  ticket        SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorAccount Account?      @relation(fields: [authorAccountId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([authorAccountId])
}
