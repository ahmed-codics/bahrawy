{
  "name": "@bahrawy/db",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "generate": "prisma generate",
    "typecheck": "tsc --noEmit && tsc prisma/seed.ts --noEmit --skipLibCheck --moduleResolution node --esModuleInterop --target ES2022 --module commonjs",
    "test": "jest",
    "migrate": "prisma migrate dev",
    "deploy": "prisma migrate deploy",
    "verify:migrations": "node scripts/verify-migration.js",
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@bahrawy/config": "1.0.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "argon2": "^0.41.1",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.1",
    "@types/pg": "^8.20.0",
    "prisma": "7.8.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
