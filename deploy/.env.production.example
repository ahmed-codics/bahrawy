NODE_ENV=production
PORT=3000

# Temporary testing hostnames. Replace these when the client chooses a domain.
ACADEMY_HOST=academy.31-97-182-119.sslip.io
ADMIN_HOST=admin.31-97-182-119.sslip.io
ACME_EMAIL=admin@example.com
ACADEMY_WEB_URL=https://academy.31-97-182-119.sslip.io
STAFF_ADMIN_URL=https://admin.31-97-182-119.sslip.io
API_ORIGIN=https://academy.31-97-182-119.sslip.io/api
PUBLIC_ORIGIN=https://academy.31-97-182-119.sslip.io
NEXT_PUBLIC_API_URL=https://academy.31-97-182-119.sslip.io/api
PROXY_TRUST=uniquelocal

POSTGRES_USER=academy
POSTGRES_PASSWORD=GENERATE_A_RANDOM_HEX_VALUE
POSTGRES_DB=bahrawy_db
DATABASE_URL=postgresql://academy:GENERATE_A_RANDOM_HEX_VALUE@postgres:5432/bahrawy_db
VALKEY_URL=redis://valkey:6379

COOKIE_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
ENCRYPTION_KEY=GENERATE_EXACTLY_64_HEX_CHARACTERS
HMAC_KEY=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
VIDEO_SIGNING_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
VIDEO_DELIVERY_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS

# Local non-video uploads. The Compose stack persists /app/apps/api/.uploads.
HLS_STORAGE_PATH=/app/apps/api/.uploads/hls
UPLOAD_STORAGE_PATH=/app/apps/api/.uploads
CLAMAV_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Required by current config validation. Replace before the final launch.
CLOUDFLARE_ACCESS_AUDIENCE=temporary-testing
CLOUDFLARE_ACCESS_TEAM_DOMAIN=temporary.cloudflareaccess.com
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Add R2 credentials when the video bucket is ready.
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=bahrawy-videos
# R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# R2_REGION=auto
